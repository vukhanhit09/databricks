{
  "datasets": [
    {
      "name": "7f0e29bd",
      "displayName": "Dữ liệu Chuyển Dịch Tiết Kiệm Số",
      "queryLines": [
        "SELECT \n",
        "  CDR_DT as Ngay_Bao_Cao,\n",
        "  PD_TP as San_Pham,\n",
        "  CHANNEL as Kenh,\n",
        "  SUB_RGON as Vung,\n",
        "  CST_GRP as Phan_Khuc,\n",
        "  GRP_AGE as Nhom_Tuoi,\n",
        "  BRANCH_NAME as Ten_Chi_Nhanh,\n",
        "  PRN_OU_TP as Smart_Bank,\n",
        "  NEW_OPN_TVR_TDY as Doanh_So_Mo_Moi_Ngay,\n",
        "  NBR_OF_NEW_AC_TDY as So_TK_Mo_Moi_Ngay,\n",
        "  NBR_OF_NEW_AC_CST_TDY as So_KH_Mo_Moi_Ngay,\n",
        "  CLS_BOOK_BAL as So_Du_Chot_Ngay,\n",
        "  NBR_OF_TVR_CST_TDY as So_KH_Co_So_Du,\n",
        "  NBR_OF_AC_W_BAL_TDY as So_Luong_So_Co_So_Du,\n",
        "  NEW_OPN_TVR_YST as Doanh_So_Mo_Ngay_Truoc,\n",
        "  NBR_OF_NEW_AC_YST as So_TK_Mo_Ngay_Truoc,\n",
        "  CLS_BOOK_BAL_YST as So_Du_Ngay_Truoc,\n",
        "  NEW_OPN_TVR_PRE_MO as Doanh_So_Mo_Thang_Truoc,\n",
        "  NBR_OF_NEW_AC_PRE_MO as So_TK_Mo_Thang_Truoc,\n",
        "  NEW_OPN_TVR_MTD as Doanh_So_Mo_Trong_Thang\n",
        "FROM rpt_khcn_hdv_d09_dgtal_svg\n",
        "WHERE PD_TP = 'TGTK'\n",
        "  AND CDR_DT <= DATE'2025-06-30'"
      ],
      "columns": [
        {
          "displayName": "Ti_Le_CD_Doanh_So",
          "description": "Tỉ lệ chuyển dịch doanh số so với ngày trước",
          "expression": "CASE WHEN `Doanh_So_Mo_Ngay_Truoc` > 0 THEN (`Doanh_So_Mo_Moi_Ngay` - `Doanh_So_Mo_Ngay_Truoc`) / `Doanh_So_Mo_Ngay_Truoc` ELSE 0 END"
        },
        {
          "displayName": "Ti_Le_CD_So_Luong_TK",
          "description": "Tỉ lệ chuyển dịch số lượng TK so với ngày trước",
          "expression": "CASE WHEN `So_TK_Mo_Ngay_Truoc` > 0 THEN (`So_TK_Mo_Moi_Ngay` - `So_TK_Mo_Ngay_Truoc`) / `So_TK_Mo_Ngay_Truoc` ELSE 0 END"
        },
        {
          "displayName": "Ti_Le_CD_So_Du",
          "description": "Tỉ lệ chuyển dịch số dư so với ngày trước",
          "expression": "CASE WHEN `So_Du_Ngay_Truoc` > 0 THEN (`So_Du_Chot_Ngay` - `So_Du_Ngay_Truoc`) / `So_Du_Ngay_Truoc` ELSE 0 END"
        },
        {
          "displayName": "Kenh_So",
          "description": "Đánh dấu kênh số",
          "expression": "CASE WHEN `Kenh` = 'KENH_SO' THEN 1 ELSE 0 END"
        }
      ],
      "catalog": "mb_poc",
      "schema": "gold"
    },
    {
      "name": "8556eadb",
      "displayName": "Số dư tiết kiệm theo chiều phân tích",
      "queryLines": [
        "SELECT \n",
        "  CDR_DT as Ngay_Bao_Cao,\n",
        "  PD_TP as San_Pham,\n",
        "  CHANNEL as Kenh,\n",
        "  SUB_RGON as Vung,\n",
        "  CST_GRP as Phan_Khuc,\n",
        "  GRP_AGE as Nhom_Tuoi,\n",
        "  BRANCH_NAME as Chi_Nhanh,\n",
        "  PRN_OU_TP as Khoi,\n",
        "  SPCL_INT_RATE_F as Co_Voucher,\n",
        "  CLS_BOOK_BAL as So_Du_Chot_Ngay,\n",
        "  NBR_OF_TVR_CST_TDY as So_KH_Co_So_Du,\n",
        "  NBR_OF_AC_W_BAL_TDY as So_Luong_So_Co_So_Du,\n",
        "  CLS_BOOK_BAL_YST as So_Du_Ngay_Truoc\n",
        "FROM rpt_khcn_hdv_d09_dgtal_svg\n",
        "WHERE PD_TP = 'TGTK'\n",
        "  AND CDR_DT <= DATE'2025-06-30'"
      ],
      "columns": [
        {
          "displayName": "So_Du_Tiet_Kiem_So",
          "description": "Số dư tiết kiệm kênh số",
          "expression": "CASE WHEN `Kenh` = 'KENH_SO' THEN `So_Du_Chot_Ngay` ELSE 0 END"
        },
        {
          "displayName": "So_Du_Co_Voucher",
          "description": "Số dư tiết kiệm có lãi suất ưu đãi (voucher)",
          "expression": "CASE WHEN `Co_Voucher` = 'Y' THEN `So_Du_Chot_Ngay` ELSE 0 END"
        },
        {
          "displayName": "Ti_Le_CD_So_Du_TKS",
          "description": "Tỷ lệ chuyển dịch số dư tiết kiệm số so với ngày trước",
          "expression": "CASE WHEN `Kenh` = 'KENH_SO' AND `So_Du_Ngay_Truoc` > 0 THEN (`So_Du_Chot_Ngay` - `So_Du_Ngay_Truoc`) / `So_Du_Ngay_Truoc` ELSE 0 END"
        },
        {
          "displayName": "Ty_Le_CD_Chi_Nhanh",
          "description": "Tỷ lệ chuyển dịch số của chi nhánh (%)",
          "expression": "CASE WHEN `So_Du_Chot_Ngay` > 0 THEN (`So_Du_Tiet_Kiem_So` / `So_Du_Chot_Ngay`) * 100 ELSE 0 END"
        }
      ],
      "catalog": "mb_poc",
      "schema": "gold"
    },
    {
      "name": "cf3e4529",
      "displayName": "Top 20 chi nhánh chuyển dịch số thấp nhất",
      "queryLines": [
        "SELECT \n",
        "  BRANCH_NAME as Chi_Nhanh,\n",
        "  SUB_RGON as Vung,\n",
        "  SUM(CLS_BOOK_BAL) as Tong_So_Du,\n",
        "  SUM(CASE WHEN CHANNEL = 'KENH_SO' THEN CLS_BOOK_BAL ELSE 0 END) as So_Du_TK_So,\n",
        "  CASE \n",
        "    WHEN SUM(CLS_BOOK_BAL) > 0 \n",
        "    THEN (SUM(CASE WHEN CHANNEL = 'KENH_SO' THEN CLS_BOOK_BAL ELSE 0 END) / SUM(CLS_BOOK_BAL)) * 100 \n",
        "    ELSE 0 \n",
        "  END as Ty_Le_CD_So\n",
        "FROM rpt_khcn_hdv_d09_dgtal_svg\n",
        "WHERE PD_TP = 'TGTK'\n",
        "  AND CDR_DT = (SELECT MAX(CDR_DT) FROM rpt_khcn_hdv_d09_dgtal_svg WHERE PD_TP = 'TGTK')\n",
        "GROUP BY BRANCH_NAME, SUB_RGON\n",
        "HAVING SUM(CLS_BOOK_BAL) > 0\n",
        "ORDER BY Ty_Le_CD_So ASC\n",
        "LIMIT 20"
      ],
      "catalog": "mb_poc",
      "schema": "gold"
    }
  ],
