{
  "datasets": [
    {
      "name": "ff2735da",
      "displayName": "Param",
      "queryLines": [
        "SELECT\r\n",
        "`CDR_DT`\r\n",
        "FROM\r\n",
        "  `mb_poc`.`gold`.`rpt_nhs_d01_smy`\r\n"
      ]
    },
    {
      "name": "c2d8f667",
      "displayName": "Channel_age",
      "queryLines": [
        "SELECT\r\n",
        "  `MKT_CNL_GRP` AS app_onboarding_channel,\r\n",
        "  `AGE_GRP` AS age_group,\r\n",
        "  SUM(`NBR_APP_NEW_MTD`) AS total_new_apps_month,\r\n",
        "  SUM(`NBR_ACTV_APP`) AS total_active_apps,\r\n",
        "  SUM(`NBR_NFC_SCS`) AS total_nfc_success\r\n",
        "FROM\r\n",
        "  `mb_poc`.`gold`.`rpt_nhs_d01_smy`\r\n",
        "WHERE `CDR_DT` = :p_date and\r\n",
        "  `MKT_CNL_GRP` IS NOT NULL AND `AGE_GRP` IS NOT NULL \r\n",
        "GROUP BY\r\n",
        "  `MKT_CNL_GRP`,\r\n",
        "  `AGE_GRP`"
      ],
      "parameters": [
        {
          "displayName": "Ngày báo cáo",
          "keyword": "p_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2025-12-31T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5a7da970",
      "displayName": "App_7Days",
      "queryLines": [
        "SELECT\r\n",
        "  `MKT_CNL_GRP` AS app_onboarding_channel,\r\n",
        "  `CDR_DT` AS report_date,\r\n",
        "  SUM(`NBR_APP_NEW_D`) AS total_new_apps\r\n",
        "FROM\r\n",
        "  `mb_poc`.`gold`.`rpt_nhs_d01_smy`\r\n",
        "WHERE\r\n",
        "  `CDR_DT` BETWEEN DATE_SUB(:p_date, 6) AND :p_date\r\n",
        "GROUP BY\r\n",
        "  `MKT_CNL_GRP`,`CDR_DT`\r\n",
        "ORDER BY\r\n",
        "  report_date ASC,\r\n",
        "  app_onboarding_channel ASC"
      ],
      "parameters": [
        {
          "displayName": "p_date",
          "keyword": "p_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2025-12-31T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "a62e6a6f",
      "displayName": "Top15_rm",
      "queryLines": [
        "SELECT\r\n",
        "  `RM_CODE`,\r\n",
        "  `RM_NM`,\r\n",
        "  SUM(`NBR_APP_NEW_YTD`) AS total_app_new_ytd\r\n",
        "FROM\r\n",
        "  `mb_poc`.`gold`.`rpt_nhs_d01_kpi_branch`\r\n",
        "WHERE `CDR_DT` <= :p_date \r\n",
        "  AND `RM_CODE` IS NOT NULL\r\n",
        "  AND `RM_NM` IS NOT NULL\r\n",
        "  AND `NBR_APP_NEW_YTD` IS NOT NULL\r\n",
        "GROUP BY\r\n",
        "  `RM_CODE`,\r\n",
        "  `RM_NM`\r\n",
        "ORDER BY\r\n",
        "  total_app_new_ytd DESC\r\n",
        "LIMIT 15"
      ],
      "parameters": [
        {
          "displayName": "p_date",
          "keyword": "p_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2025-12-31T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "72f97927",
      "displayName": "Compare",
      "queryLines": [
        "SELECT\r\n",
        "  `MKT_CNL_GRP` AS app_onboarding_channel,\r\n",
        "  SUM(`NBR_APP_NEW_MTD`) AS total_app_new_mtd_ht,\r\n",
        "  0 AS total_app_new_mtd_tt,\r\n",
        "  0 as total_app_new_mtd_nt\r\n",
        "FROM\r\n",
        "  `mb_poc`.`gold`.`rpt_nhs_d01_smy`\r\n",
        "WHERE\r\n",
        "  month(`CDR_DT`) = month(:p_date) and year(`CDR_DT`) = year(:p_date)\r\n",
        "  AND `MKT_CNL_GRP` IS NOT NULL\r\n",
        "GROUP BY\r\n",
        "  `MKT_CNL_GRP`\r\n",
        "union all\r\n",
        "SELECT\r\n",
        "  `MKT_CNL_GRP` AS app_onboarding_channel,\r\n",
        "  0 as total_app_new_mtd_ht,\r\n",
        "  SUM(`NBR_APP_NEW_MTD`) AS total_app_new_mtd_tt,\r\n",
        "  0 as total_app_new_mtd_nt\r\n",
        "FROM\r\n",
        "  `mb_poc`.`gold`.`rpt_nhs_d01_smy`\r\n",
        "WHERE\r\n",
        "  month(`CDR_DT`) = month(:p_date) - 1 and year(`CDR_DT`) = year(:p_date)\r\n",
        "  AND `MKT_CNL_GRP` IS NOT NULL\r\n",
        "GROUP BY\r\n",
        "  `MKT_CNL_GRP`\r\n",
        "union all\r\n",
        "SELECT\r\n",
        "  `MKT_CNL_GRP` AS app_onboarding_channel,\r\n",
        "  0 as total_app_new_mtd_ht,\r\n",
        "  0 AS total_app_new_mtd_tt,\r\n",
        "  SUM(`NBR_APP_NEW_MTD`) as total_app_new_mtd_nt\r\n",
        "FROM\r\n",
        "  `mb_poc`.`gold`.`rpt_nhs_d01_smy`\r\n",
        "WHERE\r\n",
        "  month(`CDR_DT`) = month(:p_date) and year(`CDR_DT`) = year(:p_date)-1\r\n",
        "  AND `MKT_CNL_GRP` IS NOT NULL\r\n",
        "GROUP BY\r\n",
        "  `MKT_CNL_GRP`\r\n"
      ],
      "parameters": [
        {
          "displayName": "p_date",
          "keyword": "p_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2025-12-31T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    }
  ],
