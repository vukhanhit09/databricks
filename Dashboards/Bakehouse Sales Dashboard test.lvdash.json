{
  "datasets": [
    {
      "name": "2f4d5f4e",
      "displayName": "Sales Overview",
      "queryLines": [
        "SELECT \n",
        "    COUNT(*) as total_transactions,\n",
        "    COUNT(DISTINCT customerID) as unique_customers,\n",
        "    COUNT(DISTINCT franchiseID) as unique_franchises,\n",
        "    COUNT(DISTINCT product) as unique_products,\n",
        "    SUM(totalPrice) as total_revenue,\n",
        "    SUM(quantity) as total_items_sold\n",
        "FROM sales_transactions"
      ],
      "catalog": "samples",
      "schema": "bakehouse"
    },
    {
      "name": "7b203642",
      "displayName": "Hourly Sales Pattern",
      "queryLines": [
        "SELECT \n",
        "    HOUR(dateTime) as hour_of_day,\n",
        "    COUNT(*) as num_transactions,\n",
        "    SUM(totalPrice) as total_revenue\n",
        "FROM sales_transactions\n",
        "GROUP BY HOUR(dateTime)\n",
        "ORDER BY hour_of_day"
      ],
      "catalog": "samples",
      "schema": "bakehouse"
    },
    {
      "name": "74deda8a",
      "displayName": "Payment Methods",
      "queryLines": [
        "SELECT \n",
        "    paymentMethod,\n",
        "    COUNT(*) as num_transactions,\n",
        "    SUM(totalPrice) as total_revenue\n",
        "FROM sales_transactions\n",
        "GROUP BY paymentMethod\n",
        "ORDER BY num_transactions DESC"
      ],
      "catalog": "samples",
      "schema": "bakehouse"
    },
    {
      "name": "ee3f58b5",
      "displayName": "Daily Sales Trend",
      "queryLines": [
        "SELECT \n",
        "    DATE(dateTime) as transaction_date,\n",
        "    SUM(totalPrice) as daily_revenue,\n",
        "    COUNT(*) as num_transactions,\n",
        "    SUM(quantity) as items_sold\n",
        "FROM sales_transactions\n",
        "GROUP BY DATE(dateTime)\n",
        "ORDER BY transaction_date"
      ],
      "catalog": "samples",
      "schema": "bakehouse"
    },
    {
      "name": "5fbe4785",
      "displayName": "Sales by Product",
      "queryLines": [
        "SELECT \n",
        "    product,\n",
        "    SUM(totalPrice) as total_revenue,\n",
        "    SUM(quantity) as total_quantity,\n",
        "    COUNT(*) as num_transactions\n",
        "FROM sales_transactions\n",
        "GROUP BY product\n",
        "ORDER BY total_revenue DESC"
      ],
      "catalog": "samples",
      "schema": "bakehouse"
    }
  ],
