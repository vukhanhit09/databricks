{
  "datasets": [
    {
      "name": "998c90ee",
      "displayName": "SoDuTietKiem",
      "queryLines": [
        "SELECT \n",
        "  DATE_FORMAT(CDR_DT, 'yyyy-MM') AS Thang,\n",
        "  CST_LOB_NM AS Khoi_khach_hang,\n",
        "  CHANNEL AS Kenh,\n",
        "  SUM(CLS_BOOK_BAL) AS So_du_hien_tai,\n",
        "  SUM(CLS_BOOK_BAL_LST_MO) AS So_du_thang_truoc,\n",
        "  SUM(CLS_BOOK_BAL_LST_YR) AS So_du_cung_ky_nam_truoc,\n",
        "  SUM(NBR_OF_AC_W_BAL_TDY) AS So_luong_so_hien_tai,\n",
        "  SUM(NBR_OF_TVR_CST_TDY) AS So_luong_khach_hang,\n",
        "  SUM(NEW_OPN_TVR_MTD) AS Doanh_so_mo_moi_trong_thang\n",
        "FROM mb_poc.gold.rpt_khcn_hdv_d09_dgtal_svg\n",
        "WHERE PD_TP = 'TGTK'\n",
        "GROUP BY DATE_FORMAT(CDR_DT, 'yyyy-MM'), CST_LOB_NM, CHANNEL"
      ],
      "columns": [
        {
          "displayName": "Bien_dong_so_voi_thang_truoc",
          "description": "Biến động số dư so với tháng trước",
          "expression": "`So_du_hien_tai` - `So_du_thang_truoc`"
        },
        {
          "displayName": "Ty_le_tang_truong_thang",
          "description": "Tỷ lệ tăng trưởng so với tháng trước (%)",
          "expression": "CASE WHEN `So_du_thang_truoc` > 0 THEN ((`So_du_hien_tai` - `So_du_thang_truoc`) / `So_du_thang_truoc`) * 100 ELSE 0 END"
        },
        {
          "displayName": "Bien_dong_so_voi_cung_ky",
          "description": "Biến động số dư so với cùng kỳ năm trước",
          "expression": "`So_du_hien_tai` - `So_du_cung_ky_nam_truoc`"
        },
        {
          "displayName": "Ty_le_tang_truong_nam",
          "description": "Tỷ lệ tăng trưởng so với cùng kỳ năm trước (%)",
          "expression": "CASE WHEN `So_du_cung_ky_nam_truoc` > 0 THEN ((`So_du_hien_tai` - `So_du_cung_ky_nam_truoc`) / `So_du_cung_ky_nam_truoc`) * 100 ELSE 0 END"
        },
        {
          "displayName": "Ty_le_chuyen_dich_kenh_so",
          "description": "Tỷ lệ số dư theo kênh so với tổng số dư (%)",
          "expression": "(`So_du_hien_tai` / NULLIF(SUM(`So_du_hien_tai`) OVER (PARTITION BY `Thang`, `Khoi_khach_hang`), 0)) * 100"
        },
        {
          "displayName": "So_du_binh_quan_tren_so",
          "description": "Số dư bình quân trên mỗi sổ tiết kiệm",
          "expression": "CASE WHEN `So_luong_so_hien_tai` > 0 THEN `So_du_hien_tai` / `So_luong_so_hien_tai` ELSE 0 END"
        },
        {
          "displayName": "So_du_binh_quan_tren_KH",
          "description": "Số dư bình quân trên mỗi khách hàng",
          "expression": "CASE WHEN `So_luong_khach_hang` > 0 THEN `So_du_hien_tai` / `So_luong_khach_hang` ELSE 0 END"
        },
        {
          "displayName": "Ty_le_chuyen_dich_so_luong_so",
          "description": "Tỷ lệ số lượng sổ theo kênh so với tổng số lượng sổ (%)",
          "expression": "(`So_luong_so_hien_tai` / NULLIF(SUM(`So_luong_so_hien_tai`) OVER (PARTITION BY `Thang`, `Khoi_khach_hang`), 0)) * 100"
        },
        {
          "displayName": "Ty_le_chuyen_dich_khach_hang",
          "description": "Tỷ lệ số lượng khách hàng theo kênh so với tổng khách hàng (%)",
          "expression": "(`So_luong_khach_hang` / NULLIF(SUM(`So_luong_khach_hang`) OVER (PARTITION BY `Thang`, `Khoi_khach_hang`), 0)) * 100"
        }
      ],
      "catalog": "mb_poc",
      "schema": "gold"
    }
  ],
