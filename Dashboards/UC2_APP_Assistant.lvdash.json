  "datasets": [
    {
      "name": "3f4fe9d4",
      "displayName": "App Opening by Channel",
      "queryLines": [
        "SELECT * FROM rpt_nhs_d01_smy WHERE CDR_DT >= :selected_date - INTERVAL 6 DAYS AND CDR_DT <= :selected_date"
      ],
      "parameters": [
        {
          "displayName": "Ngày kết thúc",
          "keyword": "selected_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2025-12-31"
                }
              ]
            }
          }
        }
      ],
      "catalog": "mb_poc",
      "schema": "gold"
    },
    {
      "name": "bee0aa0e",
      "displayName": "App Opening by Channel and Date",
      "queryLines": [
        "SELECT \n",
        "  CDR_DT,\n",
        "  MKT_CNL_GRP,\n",
        "  SUM(NBR_APP) as total_app,\n",
        "  SUM(NBR_APP_NEW_D) as new_app_daily,\n",
        "  SUM(NBR_APP_NEW_MTD) as new_app_mtd,\n",
        "  SUM(NBR_APP_NEW_YTD) as new_app_ytd,\n",
        "  SUM(NBR_ACTV_APP) as active_app,\n",
        "  SUM(NBR_ACTV_LOGIN) as active_login_91d,\n",
        "  SUM(NBR_ACTV_TXN_3M) as active_txn_3m,\n",
        "  SUM(NBR_ACTV_TXN_1M) as active_txn_1m,\n",
        "  SUM(NBR_NFC_SCS) as nfc_success\n",
        "FROM rpt_nhs_d01_smy\n",
        "WHERE CDR_DT >= :selected_date - INTERVAL 6 DAYS AND CDR_DT <= :selected_date\n",
        "GROUP BY CDR_DT, MKT_CNL_GRP\n",
        "ORDER BY CDR_DT DESC, MKT_CNL_GRP"
      ],
      "parameters": [
        {
          "displayName": "Ngày kết thúc",
          "keyword": "selected_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2025-12-31"
                }
              ]
            }
          }
        }
      ],
      "catalog": "mb_poc",
      "schema": "gold"
    }
  ],
