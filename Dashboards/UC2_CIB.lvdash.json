{
  "datasets": [
    {
      "name": "d7cf03d6",
      "displayName": "TQKQKD_2",
      "queryLines": [
        "select Year(`TXN_DT`) as Nam, month(`TXN_DT`) as Thang, `BR_CODE` as MaCN,`BR_NM` as TenCN, case when `HUB_F`='Y' then 'HUB' else 'NON-HUB' end as HUB,`RGON` as Vung_CIB,`CST_GRP`,\r\n",
        "    `VND_SHRT_LOAN_BAL` + `VND_LN_LOAN_BAL` + `USD_SHRT_LOAN_BAL` + `USD_LN_LOAN_BAL` as TongDuNo,\r\n",
        "    `ARS_BAL` as NoQuaHan   \r\n",
        "from mb_poc.data_raw.cib\r\n",
        "--where Year(TXN_DT) = :p_year and (:p_month is null or array_contains(:p_month, month(TXN_DT)))"
      ]
    },
    {
      "name": "9b4bec2b",
      "displayName": "TQKQKD_ 1",
      "queryLines": [
        "select Year(`TXN_DT`) as Nam, month(`TXN_DT`) as Thang, `BR_CODE` as MaCN,`BR_NM` as TenCN, case when `HUB_F`='Y' then 'HUB' else 'NON-HUB' end as HUB,`RGON` as Vung_CIB,`CST_GRP`,\r\n",
        "    `VND_SHRT_LOAN_BAL` + `VND_LN_LOAN_BAL` + `USD_SHRT_LOAN_BAL` + `USD_LN_LOAN_BAL` as DuNo,\r\n",
        "    `VND_AVG_SHRT_LOAN_BAL_YTD` + `VND_AVG_LN_LOAN_BAL_YTD` + `USD_AVG_SHRT_LOAN_BAL_YTD` + `USD_AVG_LN_LOAN_BAL_YTD` as DuNo_BinhQuan,\r\n",
        "    `BOND_BAL`,`AVG_BOND_BAL_YTD`,\r\n",
        "    `VND_SHRT_LOAN_BAL` + `VND_LN_LOAN_BAL` + `USD_SHRT_LOAN_BAL` + `USD_LN_LOAN_BAL` + `BOND_BAL`  as DuNo_TraiPhieu,\r\n",
        "    `VND_AVG_SHRT_LOAN_BAL_YTD` + `VND_AVG_LN_LOAN_BAL_YTD` + `USD_AVG_SHRT_LOAN_BAL_YTD` + `USD_AVG_LN_LOAN_BAL_YTD` + `AVG_BOND_BAL_YTD` as DuNo_BinhQuan_TraiPhieu,\r\n",
        "    `VND_CASA_BAL` + `VND_TERM_FD_BAL` + `USD_CASA_BAL` + `USD_TERM_FD_BAL`  as HuyDong,\r\n",
        "    `VND_AVG_CASA_YTD` + `VND_AVG_TERM_FD_YTD` + `USD_AVG_CASA_YTD` + `USD_AVG_TERM_FD_YTD`  as HuyDong_BinhQuan,\r\n",
        "    `GNT_BAL` as BaoLanh, `AVG_GNT_BAL_YTD` as BaoLanh_BinhQuan\r\n",
        "from mb_poc.data_raw.cib\r\n",
        "--where Year(TXN_DT) = :p_year and (:p_month is null or array_contains(:p_month, month(TXN_DT)))"
      ]
    }
  ],
